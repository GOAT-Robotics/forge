PORT=8100
COOKIE_SECURE=false
# Public URL (used for the Microsoft sign-in redirect), e.g. https://forge.goat-robotics.com
PUBLIC_URL=http://localhost:8100
# Additional trusted local address for Microsoft sign-in (HTTPS proxy profile)
PUBLIC_URLS=https://naveen.local:8443
# Signs model links and sign-in state; generate with: openssl rand -hex 32
FORGE_SECRET=
# Microsoft Entra ID sign-in (scripts/entra-register.sh fills these in)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=   # https://login.microsoftonline.com/<tenant-id>/v2.0/
# Only these e-mail domains may use Forge
ALLOWED_EMAIL_DOMAINS=goat-robotics.com
# Comma-separated administrators; otherwise the first person to sign in becomes administrator
ADMIN_EMAILS=naveen@goat-robotics.com
DEFAULT_ROLE=viewer
# Password sign-in is disabled once Entra is configured; set true only for break-glass access
FORGE_ALLOW_LOCAL_LOGIN=false
# Parallel drawing generation processes in the worker
FORGE_DRAWING_WORKERS=3
MAX_UPLOAD_MB=1024
# Set to ephemeral only after the DigitalOcean/Spaces settings below are present.
CAD_EXECUTION_MODE=local
